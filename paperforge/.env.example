# Required for real runs (not for --demo). Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: Slack bot token (scopes: files:read, channels:read) for figure-style reference
SLACK_BOT_TOKEN=
# Optional: needed only to clone private GitHub repos
GITHUB_TOKEN=
# Required when the web UI is reachable from other machines
PAPERFORGE_PASSWORD=
